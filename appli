<style>
@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');

:root{
  --paper:#F7F3EA; --paper-alt:#EFE9DA; --ink:#1E2A33; --ink-soft:#5B6670; --line:#D9D0BC;
  --gold:#B0873A; --brick:#8B3E30; --sage:#5C7A5A; --white:#FFFFFF;
}
*{ box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
html,body{ margin:0; padding:0; background:#E4DCC6; height:100%; overscroll-behavior:none; }
body{ font-family:'IBM Plex Sans',-apple-system,sans-serif; color:var(--ink); position:fixed; inset:0; width:100%; }
.serif{ font-family:'Fraunces',serif; }
.mono{ font-family:'IBM Plex Mono',monospace; }

#shell{ width:100%; height:100%; display:flex; justify-content:center; }
#root{ width:100%; max-width:460px; height:100%; background:var(--paper); color:var(--ink);
  display:flex; flex-direction:column; position:relative; overflow:hidden; box-shadow:0 0 0 1px var(--line); }

.topbar{ flex-shrink:0; padding:calc(16px + env(safe-area-inset-top)) 18px 14px 18px; border-bottom:1px solid var(--line);
  display:flex; align-items:center; justify-content:space-between; background:var(--paper); }
.topbar-title{ font-size:18px; }
.topbar-sub{ font-size:11.5px; color:var(--ink-soft); margin-top:2px; }

#main{ flex:1; min-height:0; overflow-y:auto; padding:18px 16px 28px 16px; -webkit-overflow-scrolling:touch; }

.bottomnav{ flex-shrink:0; display:flex; border-top:1px solid var(--line); background:var(--paper);
  padding-bottom:env(safe-area-inset-bottom); }
.navbtn{ flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; padding:10px 4px 12px 4px;
  background:none; border:none; cursor:pointer; color:var(--ink-soft); font-size:11px; font-family:'IBM Plex Sans',sans-serif;
  border-top:2px solid transparent; }
.navbtn.active{ color:var(--ink); border-top:2px solid var(--gold); }
.navbtn svg{ width:19px; height:19px; }

.h1{ font-family:'Fraunces',serif; font-size:23px; margin:0; }
.h1-sub{ color:var(--ink-soft); font-size:13px; margin-top:3px; }
.header{ margin-bottom:18px; display:flex; align-items:flex-start; justify-content:space-between; gap:10px; }

.kpi-row{ display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--line); border:1px solid var(--line); margin-bottom:20px; }
.kpi{ background:var(--paper); padding:14px 14px; }
.kpi-num{ font-family:'Fraunces',serif; font-size:25px; line-height:1; }
.kpi-label{ font-size:11.5px; color:var(--ink-soft); margin-top:6px; line-height:1.3; }

.panel{ background:var(--paper); border:1px solid var(--line); padding:16px; margin-bottom:16px; }
.panel-title{ font-family:'Fraunces',serif; font-size:15.5px; margin:0 0 12px 0; }

.icon-btn{ display:inline-flex; align-items:center; justify-content:center; gap:5px; width:38px; height:38px;
  border:1px solid var(--line); background:var(--white); cursor:pointer; flex-shrink:0; position:relative; }
.icon-btn svg{ width:16px; height:16px; }
.filter-badge{ position:absolute; top:-4px; right:-4px; background:var(--brick); color:var(--white); font-size:9.5px;
  width:15px; height:15px; border-radius:50%; display:flex; align-items:center; justify-content:center; }

.search{ position:relative; flex:1; }
.search input{ width:100%; padding:9px 12px 9px 32px; border:1px solid var(--line); background:var(--white);
  font-family:'IBM Plex Sans',sans-serif; font-size:14px; color:var(--ink); }
.search svg{ position:absolute; left:9px; top:50%; transform:translateY(-50%); color:var(--ink-soft); width:15px; height:15px; }
.toolbar{ display:flex; gap:8px; margin-bottom:14px; }

.btn{ display:inline-flex; align-items:center; justify-content:center; gap:6px; padding:10px 14px; border:1px solid var(--ink);
  background:var(--ink); color:var(--paper); font-size:14px; cursor:pointer; font-family:'IBM Plex Sans',sans-serif; width:100%; }
.btn svg{ width:14px; height:14px; }
.btn.ghost{ background:transparent; color:var(--ink); border:1px solid var(--line); }
.btn.danger{ background:transparent; color:var(--brick); border:1px solid var(--brick); }
.btn:disabled{ opacity:0.4; cursor:not-allowed; }

.card-list{ border:1px solid var(--line); background:var(--white); }
.card{ padding:12px 14px; border-bottom:1px solid var(--line); display:flex; align-items:center; gap:10px; cursor:pointer; }
.card:last-child{ border-bottom:none; }
.card:active{ background:var(--paper-alt); }
.card-body{ flex:1; min-width:0; }
.card-top{ display:flex; align-items:center; gap:7px; margin-bottom:3px; }
.card-name{ font-weight:500; font-size:14.5px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.card-meta{ font-size:12px; color:var(--ink-soft); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.card-foot{ font-size:11.5px; color:var(--ink-soft); margin-top:3px; display:flex; gap:8px; }
.card-foot .mono{ color:var(--ink); }
.card svg{ width:16px; height:16px; color:var(--ink-soft); flex-shrink:0; }

.badge{ font-size:10.5px; padding:2px 6px; display:inline-block; border:1px solid; white-space:nowrap; flex-shrink:0; }
.badge.client{ color:var(--gold); border-color:var(--gold); }
.badge.prospect{ color:var(--brick); border-color:var(--brick); }

.empty{ padding:36px 16px; text-align:center; color:var(--ink-soft); }
.empty .serif{ font-size:16.5px; color:var(--ink); display:block; margin-bottom:6px; }

.pagination{ display:flex; align-items:center; justify-content:space-between; margin-top:14px; font-size:12.5px; color:var(--ink-soft); }
.pg-btns{ display:flex; gap:6px; }
.pg-btn{ border:1px solid var(--line); background:var(--white); width:32px; height:32px; display:flex; align-items:center; justify-content:center; cursor:pointer; }
.pg-btn:disabled{ opacity:0.35; cursor:not-allowed; }
.pg-btn svg{ width:16px; height:16px; }

.sheet-overlay{ position:absolute; inset:0; background:rgba(30,42,51,0.4); display:flex; align-items:flex-end; z-index:50; }
.sheet{ width:100%; max-height:88%; background:var(--paper); overflow-y:auto; padding:18px 18px 28px 18px;
  border-top:1px solid var(--line); border-radius:14px 14px 0 0; animation:slideup .2s ease-out; }
@keyframes slideup{ from{ transform:translateY(16px); opacity:0; } to{ transform:translateY(0); opacity:1; } }
.sheet.full{ height:100%; max-height:100%; border-radius:0; }
.sheet-handle{ width:36px; height:4px; background:var(--line); border-radius:2px; margin:0 auto 14px auto; }
.sheet-head{ display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px; }
.sheet-close{ background:none; border:none; cursor:pointer; color:var(--ink-soft); padding:4px; }
.sheet-close svg{ width:20px; height:20px; }

.field{ margin-bottom:13px; }
.field label{ display:block; font-size:11.5px; color:var(--ink-soft); margin-bottom:5px; }
.field input, .field select{ width:100%; padding:9px 10px; border:1px solid var(--line); background:var(--white);
  font-family:'IBM Plex Sans',sans-serif; font-size:14px; color:var(--ink); }
.field-row{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }

.detail-row{ display:flex; gap:10px; padding:9px 0; border-bottom:1px solid var(--line); font-size:14px; align-items:flex-start; }
.detail-row svg{ color:var(--ink-soft); flex-shrink:0; margin-top:2px; width:15px; height:15px; }
.detail-label{ color:var(--ink-soft); width:92px; flex-shrink:0; font-size:11.5px; padding-top:1px; }
.sheet-actions{ display:flex; gap:8px; margin-top:18px; }

.contact-row{ display:flex; align-items:center; gap:10px; padding:9px 0; border-bottom:1px solid var(--line); }
.contact-row svg{ color:var(--ink-soft); flex-shrink:0; }
.contact-row .contact-value{ flex:1; min-width:0; font-size:14px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.contact-row .contact-actions{ display:flex; gap:6px; flex-shrink:0; }
.contact-action{ display:flex; align-items:center; justify-content:center; width:32px; height:32px; border:1px solid var(--line);
  background:var(--white); color:var(--ink); text-decoration:none; flex-shrink:0; }
.contact-action:active{ background:var(--paper-alt); }
.contact-action svg{ color:var(--ink); width:15px; height:15px; }

.map-frame{ border:1px solid var(--line); background:var(--paper-alt); overflow:hidden; margin:4px 0 10px 0; }
.map-frame iframe{ display:block; width:100%; height:160px; border:0; }
.map-frame .map-card-link-row{ display:flex; align-items:center; justify-content:center; gap:6px; padding:8px 10px; font-size:12.5px;
  color:var(--ink); text-decoration:none; border-top:1px solid var(--line); background:var(--white); }
.map-frame .map-card-link-row:hover{ background:var(--paper-alt); }

.map-card{ display:flex; gap:10px; align-items:flex-start; border:1px solid var(--line); background:var(--paper-alt);
  padding:12px 13px; margin:4px 0 10px 0; text-decoration:none; color:var(--ink); }
.map-card:active{ background:var(--paper); }
.map-card svg{ color:var(--brick); flex-shrink:0; margin-top:1px; }
.map-card-text{ flex:1; min-width:0; }
.map-card-addr{ font-size:13px; margin-bottom:5px; }
.map-card-link{ display:inline-flex; align-items:center; gap:4px; font-size:12.5px; color:var(--ink); font-weight:500; }
.map-card-link svg{ color:var(--ink); margin-top:0; }

.insight{ display:flex; align-items:flex-start; gap:9px; padding:9px 0; border-bottom:1px solid var(--line); font-size:12.5px; }
.insight:last-child{ border-bottom:none; }
.insight svg{ color:var(--brick); flex-shrink:0; margin-top:1px; width:15px; height:15px; }
.insight b{ font-family:'Fraunces',serif; font-size:14.5px; font-weight:600; }

.loading{ display:flex; align-items:center; justify-content:center; height:100%; width:100%;
  font-family:'Fraunces',serif; color:var(--ink-soft); }

.filter-group{ margin-bottom:16px; }
.filter-group label{ display:block; font-size:11.5px; color:var(--ink-soft); margin-bottom:6px; }
.chip-row{ display:flex; gap:8px; flex-wrap:wrap; }
.chip{ padding:7px 12px; border:1px solid var(--line); background:var(--white); font-size:13px; cursor:pointer; }
.chip.active{ background:var(--ink); color:var(--paper); border-color:var(--ink); }

.hbar-row{ display:grid; grid-template-columns:88px 1fr 34px; gap:8px; align-items:center; margin-bottom:9px; font-size:11px; }
.hbar-label{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--ink); }
.hbar-track{ background:var(--paper-alt); height:14px; position:relative; overflow:hidden; }
.hbar-fill{ height:100%; }
.hbar-num{ text-align:right; color:var(--ink-soft); font-family:'IBM Plex Mono',monospace; font-size:10.5px; }
.hbar-legend{ display:flex; gap:14px; font-size:11px; color:var(--ink-soft); margin-top:6px; }
.hbar-legend span{ display:inline-flex; align-items:center; gap:5px; }
.hbar-swatch{ width:9px; height:9px; display:inline-block; }

.donut-wrap{ display:flex; align-items:center; gap:20px; }
.donut{ width:110px; height:110px; border-radius:50%; flex-shrink:0; position:relative; }
.donut::after{ content:''; position:absolute; inset:16px; background:var(--paper); border-radius:50%; }
.donut-legend{ font-size:13px; }
.donut-legend div{ display:flex; align-items:center; gap:8px; margin-bottom:8px; }
.donut-legend .sw{ width:11px; height:11px; flex-shrink:0; }
.donut-legend b{ font-family:'Fraunces',serif; font-size:16px; }
</style>
