const hasClaudeStorage = typeof window.storage !== "undefined" && window.storage && typeof window.storage.get === "function";
const storage = {
  async get(key){
    if(hasClaudeStorage) return window.storage.get(key, false);
    const v = localStorage.getItem(key);
    return v !== null ? { key, value: v } : null;
  },
  async set(key, value){
    if(hasClaudeStorage) return window.storage.set(key, value, false);
    localStorage.setItem(key, value);
    return { key, value };
  }
};

async function loadRecords(){
  try{
    const res = await storage.get(STORAGE_KEY);
    if(res && res.value){ state.records = JSON.parse(res.value); }
    else { state.records = RAW_DATA; await storage.set(STORAGE_KEY, JSON.stringify(RAW_DATA)); }
  }catch(e){
    state.records = RAW_DATA;
    try{ await storage.set(STORAGE_KEY, JSON.stringify(RAW_DATA)); }catch(e2){}
  }
  state.loading = false;
  render();
}
async function persist(next){
  state.records = next;
  state.saving = true;
  render();
  try{ await storage.set(STORAGE_KEY, JSON.stringify(next)); }
  catch(e){ console.error("Erreur d'enregistrement", e); }
  state.saving = false;
  render();
}
function getCommerciaux(){ return Array.from(new Set(state.records.filter(r=>r.com).map(r=>r.com))).sort(); }
function getSecteurs(){ return Array.from(new Set(state.records.filter(r=>r.secteur).map(r=>r.secteur))).sort(); }

function computeStats(records){
  const total = records.length;
  const clients = records.filter(r=>r.type==="CLIENT").length;
  const prospects = total - clients;
  const commerciaux = new Set(records.filter(r=>r.com).map(r=>r.com));
  const secteurs = new Set(records.filter(r=>r.secteur).map(r=>r.secteur));
  const sansMail = records.filter(r=>!r.mail).length;
  const sansTel = records.filter(r=>!cleanPhone(r.tel1) && !cleanPhone(r.tel2)).length;
  const tauxConversion = total ? Math.round((clients/total)*100) : 0;

  const byCom = {};
  for(const r of records){
    if(!r.com) continue;
    if(!byCom[r.com]) byCom[r.com] = { name:r.com, CLIENT:0, PROSPECT:0 };
    byCom[r.com][r.type] = (byCom[r.com][r.type]||0)+1;
  }
  const commercialData = Object.values(byCom).map(d=>({...d,total:d.CLIENT+d.PROSPECT}))
    .sort((a,b)=>b.total-a.total).slice(0,10);

  const bySecteur = {};
  for(const r of records){ if(!r.secteur) continue; bySecteur[r.secteur]=(bySecteur[r.secteur]||0)+1; }
  const secteurData = Object.entries(bySecteur).map(([name,total])=>({name,total}))
    .sort((a,b)=>b.total-a.total).slice(0,8);

  return { total, clients, prospects, commerciaux:commerciaux.size, secteurs:secteurs.size, sansMail, sansTel, tauxConversion, commercialData, secteurData };
}

function hbarChart(data, maxKey){
  const max = Math.max(1, ...data.map(d=>d[maxKey] ?? d.total));
  return data.map(d=>{
    const clientPct = ((d.CLIENT||0)/max)*100;
    const prospectPct = ((d.PROSPECT||0)/max)*100;
    if(d.CLIENT !== undefined){
      return `<div class="hbar-row">
        <div class="hbar-label">${esc(d.name)}</div>
        <div class="hbar-track"><div style="display:flex;height:100%;">
          <div class="hbar-fill" style="width:${clientPct}%;background:${GOLD}"></div>
          <div class="hbar-fill" style="width:${prospectPct}%;background:${BRICK}"></div>
        </div></div>
        <div class="hbar-num">${d.total}</div>
      </div>`;
    }
    const pct = (d.total/max)*100;
    return `<div class="hbar-row">
      <div class="hbar-label">${esc(d.name)}</div>
      <div class="hbar-track"><div class="hbar-fill" style="width:${pct}%;background:${INK}"></div></div>
      <div class="hbar-num">${d.total}</div>
    </div>`;
  }).join("");
}

