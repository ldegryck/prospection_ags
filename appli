function getFiltered(){
  const term = state.q.trim().toLowerCase();
  const f = state.filters;
  return state.records.filter(r=>{
    if(f.type !== "ALL" && r.type !== f.type) return false;
    if(f.com !== "ALL" && r.com !== f.com) return false;
    if(f.secteur && r.secteur.toLowerCase() !== f.secteur.toLowerCase()) return false;
    if(term){
      const hay = (r.nom+" "+r.ville+" "+r.code+" "+r.mail+" "+r.adresse).toLowerCase();
      if(!hay.includes(term)) return false;
    }
    return true;
  });
}

