const STORAGE_KEY = "portefeuille-clients-records";
const GOLD = "#B0873A", BRICK = "#8B3E30", SAGE = "#5C7A5A", INK = "#1E2A33";

const icon = (name, size) => `<svg width="${size||16}" height="${size||16}"><use href="#ic-${name}"/></svg>`;

function cleanPhone(p){ if(!p || p === "0000000000") return ""; return p; }
function formatPhone(p){
  const c = cleanPhone(p);
  if(!c) return "—";
  const digits = c.replace(/\D/g,"");
  if(digits.length === 10) return digits.replace(/(\d{2})(?=\d)/g,"$1 ").trim();
  return c;
}
function esc(s){
  return (s ?? "").toString().replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}
function mapQuery(r){
  const q = (r.adresse && r.adresse.trim()) ? r.adresse : [r.ville, r.cp, "France"].filter(Boolean).join(" ");
  return encodeURIComponent(q);
}
function emptyRecord(nextId){
  return { id:nextId, com:"", pm:"", code:"", vte:"", siren:"", type:"PROSPECT",
    nom:"", cp:"", ville:"", adresse:"", secteur:"", mail:"", tel1:"", tel2:"" };
}
function toCSV(rows){
  const headers = ["Commercial","Personne Modification Client","Code Client","Personne Associée Vte Machine","Numéro Siren","Type Compte","Raison Sociale","Code Postal","Ville","Adresse Complète","Secteur","Mail Client","Téléphone 1","Téléphone 2"];
  const keys = ["com","pm","code","vte","siren","type","nom","cp","ville","adresse","secteur","mail","tel1","tel2"];
  const cell = (v) => { const s=(v??"").toString(); return /[",;\n]/.test(s) ? '"'+s.replace(/"/g,'""')+'"' : s; };
  const lines = [headers.map(cell).join(",")];
  for(const r of rows) lines.push(keys.map(k=>cell(r[k])).join(","));
  return lines.join("\r\n");
}
function downloadCSV(rows, filename){
  const csv = toCSV(rows);
  const blob = new Blob(["\uFEFF"+csv], { type:"text/csv;charset=utf-8;" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

