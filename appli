function render(){
  const root = document.getElementById("root");
  if(state.loading || !state.records){
    root.innerHTML = `<div class="loading">Chargement du portefeuille…</div>`;
    return;
  }
  const active = document.activeElement;
  const focusId = active && active.id ? active.id : null;
  const selStart = active && "selectionStart" in active ? active.selectionStart : null;
  const selEnd = active && "selectionEnd" in active ? active.selectionEnd : null;

  root.innerHTML = `
    <div class="topbar">
      <div>
        <div class="topbar-title serif">Portefeuille clients</div>
        <div class="topbar-sub">${state.records.length.toLocaleString("fr-FR")} contacts${state.saving?" · enregistrement…":""}</div>
