      <button class="navbtn ${state.tab==='dashboard'?'active':''}" data-action="set-tab" data-value="dashboard">${icon("grid",19)}Tableau</button>
      <button class="navbtn ${state.tab==='repertoire'?'active':''}" data-action="set-tab" data-value="repertoire">${icon("book",19)}Répertoire</button>
      <button class="navbtn ${state.tab==='gestion'?'active':''}" data-action="set-tab" data-value="gestion">${icon("clip",19)}Gestion</button>
    </div>
  `;

  if(focusId){
    const el = document.getElementById(focusId);
    if(el){
      el.focus();
      if(selStart != null && el.setSelectionRange){
        try{ el.setSelectionRange(selStart, selEnd); }catch(e){}
      }
    }
  }
  attachFormHandlers();
}

function attachFormHandlers(){
  const searchInput = document.getElementById("search-input");
  if(searchInput){
    searchInput.addEventListener("input", (e)=>{ state.q = e.target.value; state.page = 1; render(); });
  }
  const addForm = document.getElementById("add-form");
  if(addForm){
    addForm.addEventListener("submit", (e)=>{
      e.preventDefault();
      const nom = document.getElementById("af-nom").value.trim();
      if(!nom) return;
      const nextId = state.records.length ? Math.max(...state.records.map(r=>r.id))+1 : 0;
      const type = document.getElementById("af-type").value;
      const codeInput = document.getElementById("af-code").value.trim();
      const code = codeInput || (type === "PROSPECT" ? "P_"+Date.now() : "C_"+Date.now());
      const rec = {
        id: nextId, com: document.getElementById("af-com").value, pm:"", code, vte:"", siren: document.getElementById("af-siren").value,
        type, nom, cp: document.getElementById("af-cp").value, ville: document.getElementById("af-ville").value,
        adresse: document.getElementById("af-adresse").value, secteur: document.getElementById("af-secteur").value,
        mail: document.getElementById("af-mail").value, tel1: document.getElementById("af-tel1").value, tel2: document.getElementById("af-tel2").value,
      };
      state.justAdded = rec;
      persist([rec, ...state.records]);
    });
  }
}

document.getElementById("root").addEventListener("click", (e)=>{
  const el = e.target.closest("[data-action]");
  if(!el) return;
  const action = el.dataset.action;
  const id = el.dataset.id ? parseInt(el.dataset.id,10) : null;
  if(action === "close-filter" || action === "close-detail"){
    state.filterSheetOpen = false; state.selectedId = null; state.detailEdit = false; render(); return;
  }

  if(action === "set-tab"){ state.tab = el.dataset.value; state.selectedId=null; state.filterSheetOpen=false; render(); }
  else if(action === "open-filter"){ state.filterSheetOpen = true; render(); }
  else if(action === "set-filter-type"){
    state.filters.type = el.dataset.value;
    document.querySelectorAll('[data-action="set-filter-type"]').forEach(c=>c.classList.toggle("active", c.dataset.value===state.filters.type));
  }
  else if(action === "apply-filter"){
    state.filters.com = document.getElementById("filter-com").value;
    state.filters.secteur = document.getElementById("filter-secteur").value;
    state.filterSheetOpen = false; state.page = 1; render();
  }
  else if(action === "clear-filter"){
    state.filters = { type:"ALL", com:"ALL", secteur:"" }; state.filterSheetOpen = false; state.page = 1; render();
  }
  else if(action === "open-detail"){ state.selectedId = id; state.detailEdit = false; render(); }
  else if(action === "edit-detail"){ state.detailEdit = true; render(); }
  else if(action === "cancel-edit"){ state.detailEdit = false; render(); }
  else if(action === "delete-detail"){
    if(confirm("Supprimer définitivement ce contact ?")){
      persist(state.records.filter(r=>r.id !== id));
      state.selectedId = null;
    }
  }
  else if(action === "save-detail"){
    const updated = {
      id, code: document.getElementById("ef-code").value, type: document.getElementById("ef-type").value,
      nom: document.getElementById("ef-nom").value, adresse: document.getElementById("ef-adresse").value,
      cp: document.getElementById("ef-cp").value, ville: document.getElementById("ef-ville").value,
      secteur: document.getElementById("ef-secteur").value, com: document.getElementById("ef-com").value,
      mail: document.getElementById("ef-mail").value, tel1: document.getElementById("ef-tel1").value,
      tel2: document.getElementById("ef-tel2").value, siren: document.getElementById("ef-siren").value,
    };
    const original = state.records.find(r=>r.id===id);
    const merged = { ...original, ...updated };
    persist(state.records.map(r=>r.id===id ? merged : r));
    state.detailEdit = false;
  }
  else if(action === "prev-page"){ state.page = Math.max(1, state.page-1); render(); }
  else if(action === "next-page"){ state.page = state.page+1; render(); }
  else if(action === "export-filtered"){ downloadCSV(getFiltered(), "repertoire_filtre.csv"); }
  else if(action === "export-all"){ downloadCSV(state.records, "portefeuille_clients.csv"); }
  else if(action === "reset-data"){
    if(confirm("Réinitialiser toutes les données au fichier d'origine ? Cette action est irréversible.")){
      persist(RAW_DATA);
    }
  }
});

loadRecords();
</script>
